{
  "name": "github-client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "desktop:dev": "bun --cwd apps/desktop tauri dev",
    "desktop:build": "bun --cwd apps/desktop tauri build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "turbo": "^2.11.10",
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "@tanstack/db-sqlite-persistence-core@0.2.23": "patches/@tanstack%2Fdb-sqlite-persistence-core@0.2.23.patch"
  }
}
